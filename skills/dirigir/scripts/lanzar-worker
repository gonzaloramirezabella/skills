#!/bin/bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: lanzar-worker --repo PATH --name NAME --label TEXT --objetivo TEXT [--ticket ID]
                     [--branch BRANCH --base BASE] [--model fable|opus|<id>] [--orden TEXT] [--comando TEXT]
Creates the worktree when --branch is given, pre-trusts the directory, opens a tab,
starts Claude, sends the mandate and optionally the lifecycle command. Prints JSON.
USAGE
  exit 2
}

repo="" name="" label="" objetivo="" ticket="" branch="" base="" model="opus" orden="" comando=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="$2"; shift 2 ;;
    --name) name="$2"; shift 2 ;;
    --label) label="$2"; shift 2 ;;
    --objetivo) objetivo="$2"; shift 2 ;;
    --ticket) ticket="$2"; shift 2 ;;
    --branch) branch="$2"; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --orden) orden="$2"; shift 2 ;;
    --comando) comando="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$repo" ] && [ -n "$name" ] && [ -n "$label" ] && [ -n "$objetivo" ] || usage
[ "$HERDR_ENV" = 1 ] || { echo "not inside Herdr" >&2; exit 1; }
repo="$(cd "$repo" && pwd)"

case "$model" in
  fable) model="claude-fable-5-1" ;;
  opus) model="claude-opus-5-5" ;;
esac

cwd="$repo"
if [ -n "$branch" ]; then
  [ -n "$base" ] || { echo "--branch needs --base" >&2; exit 2; }
  slug="${branch//\//-}"
  cwd="$repo/.claude/worktrees/$slug"
  if [ ! -d "$cwd" ]; then
    git -C "$repo" fetch -q origin "$base"
    git -C "$repo" worktree add -b "$branch" "$cwd" "origin/$base" 2>/dev/null \
      || git -C "$repo" worktree add "$cwd" "$branch"
  fi
fi

claude_json="$HOME/.claude.json"
[ -s "$claude_json" ] || echo '{}' > "$claude_json"
if [ "$(jq -r --arg p "$cwd" '.projects[$p].hasTrustDialogAccepted // false' "$claude_json")" != "true" ]; then
  jq --arg p "$cwd" '.projects[$p].hasTrustDialogAccepted = true' "$claude_json" > "$claude_json.tmp"
  mv "$claude_json.tmp" "$claude_json"
fi

datos="$HOME/.secrets/pruebas/$(basename "$repo").env"
extra_args=()
datos_linea=""
if [ -s "$datos" ]; then
  extra_args+=(--add-dir "$(dirname "$datos")")
  datos_linea="Datos de prueba (usuarios, admin, perfiles): $datos. Leelo cuando los necesites; nunca los copies a un repo ni a un commit."
fi

out="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$cwd" --label "$label" --no-focus)"
tab="$(jq -r '.result.tab.tab_id' <<<"$out")"
pane="$(jq -r '.result.root_pane.pane_id' <<<"$out")"
sleep 2

# shellcheck disable=SC2086
if ! start="$(herdr agent start "$name" --kind claude --pane "$pane" --timeout 90000 -- --model "$model" --permission-mode auto "${extra_args[@]}" ${CLAUDE_ARGS:-} 2>&1)"; then
  if grep -q 'blocked during startup' <<<"$start"; then
    herdr agent send-keys "$name" down enter >/dev/null
    herdr agent wait "$name" --timeout 60000 >/dev/null
  else
    echo "$start" >&2
    exit 1
  fi
fi

orden_linea=""
[ -n "$orden" ] && orden_linea="Orden textual del usuario, que cubre todo lo que este objetivo necesita: «${orden}»."
ticket_linea=""
[ -n "$ticket" ] && ticket_linea="Ticket: $ticket."

mandato="Sos el worker \`$name\` del repo $repo. Tu cwd ya es el repo (o un worktree suyo): cargá su CLAUDE.md y docs/agents/.
Objetivo: $objetivo. $ticket_linea
$orden_linea
$datos_linea
El capitán corre en otro pane de Herdr y te lee con \`herdr agent read\`; no lanzás comandos de skill hasta que él te los mande. Lo que te falte y no esté en el repo ni en los datos de prueba, lo marcás con 🙋 y seguís con lo demás.
Respondé sólo \`estado: pendiente\` en su renglón y esperá el comando.
Después, cada vez que termines o te trabes, dejá como ÚLTIMO mensaje tres líneas, cada una en su renglón: \`estado:\` (hecho|bloqueado|pendiente), \`mr:\` (URL o -), \`siguiente:\` (una frase). Nada después de eso.
Si cambiás la forma de algo que consume otro repo (ruta, campo, status), decilo en \`siguiente:\` con el prefijo \`CONTRATO:\`."

herdr agent prompt "$name" "$mandato" --wait --timeout 600000 >/dev/null

status="idle"
if [ -n "$comando" ]; then
  herdr pane send-keys "$pane" esc >/dev/null
  sleep 1
  herdr agent prompt "$name" "$comando" --wait --until working --until blocked --timeout 30000 >/dev/null || true
  status="$(herdr agent list | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p) | .agent_status // "unknown"')"
fi

jq -nc --arg tab "$tab" --arg pane "$pane" --arg name "$name" --arg cwd "$cwd" --arg model "$model" --arg status "$status" --arg comando "$comando" \
  '{tab: $tab, pane: $pane, name: $name, cwd: $cwd, model: $model, status: $status, comando: $comando}'
