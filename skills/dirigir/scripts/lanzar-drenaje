#!/bin/bash
set -euo pipefail

usage() {
  echo "usage: lanzar-drenaje --repo PATH --label TEXT --base BRANCH (--parent ID[,ID] | --tasks ID[,ID]) [--model opus]" >&2
  exit 2
}

repo="" label="" base="" parent="" tasks="" model="opus"
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="$2"; shift 2 ;;
    --label) label="$2"; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    --parent) parent="$2"; shift 2 ;;
    --tasks) tasks="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$repo" ] && [ -n "$label" ] && [ -n "$base" ] && { [ -n "$parent" ] || [ -n "$tasks" ]; } || usage
[ "$HERDR_ENV" = 1 ] || { echo "not inside Herdr" >&2; exit 1; }
repo="$(cd "$repo" && pwd)"
[ -f "$repo/.sandcastle/project.json" ] || { echo "no sandcastle in $repo" >&2; exit 1; }

out="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$repo" --label "$label" --no-focus)"
tab="$(jq -r '.result.tab.tab_id' <<<"$out")"
pane="$(jq -r '.result.root_pane.pane_id' <<<"$out")"
sleep 2

if [ -n "$parent" ]; then
  herdr pane run "$pane" make sandcastle-work PARENT="$parent" BASE="$base" MODEL="$model" >/dev/null
else
  herdr pane run "$pane" make sandcastle-tasks TASKS="$tasks" BASE="$base" MODEL="$model" >/dev/null
fi

jq -nc --arg tab "$tab" --arg pane "$pane" --arg cwd "$repo" --arg parent "$parent" --arg tasks "$tasks" \
  '{tab: $tab, pane: $pane, cwd: $cwd, parent: $parent, tasks: $tasks, fin: "herdr pane wait-output \($pane) --match \"── Resumen ──\" --timeout 600000"}'
